SYNCARE_BACKEND_ORIGIN=http://127.0.0.1:8080
SYNCARE_WEB_ORIGIN=http://127.0.0.1:3000
# Only permits explicit loopback HTTP. Other hosts require HTTPS.
SYNCARE_ALLOW_LOCAL_HTTP=true
# Required: at least 32 bytes of private random material. Generate it only in the
# owner's environment, for example:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Store the generated value only in ignored .env.local (or a Windows CurrentUser
# DPAPI dpapi:v1: value, or a Linux aesgcm:v1: value handled by the server-only
# adapter). Never commit, log, paste into tickets, or reuse the empty placeholder.
SYNCARE_SESSION_SECRET=
# Linux only: absolute path to a separately provisioned raw 32-byte AES-256-GCM
# key file. It must be a regular file owned by the current user, mode 0600,
# with one link and no symlink; the adapter never creates or repairs it.
# Windows uses CurrentUser DPAPI instead and does not read this path.
SYNCARE_PRIVATE_KEY_FILE=

